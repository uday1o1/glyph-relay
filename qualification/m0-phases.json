{
  "schema_version": 1,
  "phases": [
    {
      "id": "preflight",
      "title": "Required noninteractive target prerequisites",
      "kind": "preflight",
      "required": true,
      "dependencies": [],
      "commands": [],
      "environment_names": [],
      "timeout_seconds": 300
    },
    {
      "id": "source-integrity",
      "title": "Content-addressed source manifest verification",
      "kind": "command",
      "required": true,
      "dependencies": [],
      "commands": [
        [
          "python3",
          "-m",
          "tools.gpu.source_bundle",
          "validate-source",
          "--root",
          "{source_root}",
          "--manifest",
          "{source_root}/SOURCE_MANIFEST.json"
        ]
      ],
      "environment_names": [],
      "timeout_seconds": 300
    },
    {
      "id": "native-dependencies",
      "title": "Exact NVENC headers and patched libdatachannel checkout",
      "kind": "command",
      "required": true,
      "dependencies": ["preflight", "source-integrity"],
      "commands": [
        ["bash", "scripts/bootstrap_nvcodec_headers.sh"],
        ["bash", "scripts/bootstrap_libdatachannel.sh"]
      ],
      "environment_names": ["HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY"],
      "timeout_seconds": 1800
    },
    {
      "id": "language-dependencies",
      "title": "Locked project-local TypeScript and Python environments",
      "kind": "command",
      "required": true,
      "dependencies": ["preflight", "source-integrity"],
      "commands": [
        ["corepack", "pnpm", "install", "--frozen-lockfile"],
        ["uv", "sync", "--locked"]
      ],
      "environment_names": [
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "PNPM_HOME",
        "UV_CACHE_DIR"
      ],
      "timeout_seconds": 1800
    },
    {
      "id": "portable-check",
      "title": "Formatting, analysis, portable tests, schemas, and audits",
      "kind": "command",
      "required": true,
      "dependencies": ["language-dependencies"],
      "commands": [["make", "check"]],
      "environment_names": ["CC", "CXX", "UV_CACHE_DIR"],
      "timeout_seconds": 7200
    },
    {
      "id": "sanitizers",
      "title": "Address and undefined behavior sanitizer contracts",
      "kind": "command",
      "required": true,
      "dependencies": ["preflight", "source-integrity"],
      "commands": [["bash", "scripts/ci/check_sanitizers.sh"]],
      "environment_names": ["CC", "CXX", "ASAN_OPTIONS", "UBSAN_OPTIONS"],
      "timeout_seconds": 7200
    },
    {
      "id": "gpu-build",
      "title": "Clean Linux CUDA and NVENC configure and build",
      "kind": "command",
      "required": true,
      "dependencies": ["native-dependencies", "preflight"],
      "commands": [
        ["cmake", "--preset", "linux-gpu", "--fresh"],
        ["cmake", "--build", "--preset", "linux-gpu", "--parallel"]
      ],
      "environment_names": ["CC", "CXX", "CUDAHOSTCXX", "CUDA_PATH"],
      "timeout_seconds": 3600
    },
    {
      "id": "gpu-selection",
      "title": "Per-device CUDA, H.264 NVENC, NV12, and emphasis-map selection",
      "kind": "gpu_selection",
      "required": true,
      "dependencies": ["gpu-build"],
      "commands": [],
      "environment_names": [],
      "timeout_seconds": 300
    },
    {
      "id": "doctor-gpu",
      "title": "Truthful selected-target doctor report",
      "kind": "command",
      "required": true,
      "dependencies": ["language-dependencies", "gpu-selection"],
      "commands": [
        [
          "uv",
          "run",
          "python",
          "tools/validate_doctor.py",
          "build/linux-gpu/glyphrelay",
          "schemas/doctor-v1.schema.json"
        ]
      ],
      "environment_names": [],
      "timeout_seconds": 300
    },
    {
      "id": "nvenc-capability",
      "title": "Selected-target NVENC API and emphasis-map capability probe",
      "kind": "command",
      "required": true,
      "dependencies": ["gpu-selection"],
      "commands": [["build/linux-gpu/glyphrelay_probe_nvenc"]],
      "environment_names": [],
      "timeout_seconds": 300
    },
    {
      "id": "nvenc-ownership-failure-contracts",
      "title": "Repeated NVENC pre-submit, ownership, failure, and cleanup contracts",
      "kind": "command",
      "required": true,
      "dependencies": ["gpu-build", "nvenc-capability"],
      "commands": [
        [
          "ctest",
          "--test-dir",
          "build/linux-gpu",
          "--output-on-failure",
          "--no-tests=error",
          "--repeat",
          "until-fail:10",
          "-R",
          "^native\\.gpu_contracts$"
        ]
      ],
      "environment_names": [],
      "timeout_seconds": 1800
    },
    {
      "id": "openh264-record-only",
      "title": "System OpenH264 record-only encode and independent decode",
      "kind": "command",
      "required": true,
      "dependencies": ["gpu-build"],
      "commands": [
        [
          "ctest",
          "--test-dir",
          "build/linux-gpu",
          "--output-on-failure",
          "--no-tests=error",
          "-R",
          "integration\\.(openh264_record_only|ffmpeg_decodes_openh264)"
        ]
      ],
      "environment_names": [],
      "timeout_seconds": 1800
    },
    {
      "id": "transport-contracts",
      "title": "Pinned WebRTC packetization, recovery, and final-egress contracts",
      "kind": "command",
      "required": true,
      "dependencies": ["native-dependencies"],
      "commands": [["make", "transport-check"]],
      "environment_names": ["CC", "CXX"],
      "timeout_seconds": 3600
    },
    {
      "id": "transport-packet-capture",
      "title": "Direct IPv4, supported IPv6, and TURN final-hook packet-capture equality",
      "kind": "command",
      "required": true,
      "dependencies": [
        "gpu-build",
        "language-dependencies",
        "transport-contracts"
      ],
      "commands": [
        [
          "docker",
          "pull",
          "coturn/coturn:4.15.0-r0@sha256:b0e616a8fc46c0e8d29546c8271fda2e691c9ef912812757786ea586f73f414f"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/run_m0_transport_capture.py",
          "--fixture",
          "build/linux-gpu/glyphrelay_m0_transport_fixture",
          "--output",
          "{phase_dir}/capture"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_m0_transport_capture.py",
          "{phase_dir}/capture",
          "--schemas",
          "schemas"
        ]
      ],
      "environment_names": [],
      "timeout_seconds": 1800
    },
    {
      "id": "browser-install",
      "title": "Exact project-local Chromium and Firefox binaries",
      "kind": "command",
      "required": true,
      "dependencies": ["language-dependencies"],
      "commands": [
        [
          "corepack",
          "pnpm",
          "exec",
          "playwright",
          "install",
          "chromium",
          "firefox"
        ]
      ],
      "environment_names": [
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT"
      ],
      "environment_values": { "PLAYWRIGHT_BROWSERS_PATH": "0" },
      "timeout_seconds": 3600
    },
    {
      "id": "browser-offers",
      "title": "Unmodified Chromium and Firefox recording-profile offers",
      "kind": "command",
      "required": true,
      "dependencies": ["browser-install"],
      "commands": [
        [
          "node",
          "tooling/m0/capture-browser-offers.ts",
          "--output",
          "{phase_dir}/browser-offers.json"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_m0_browser_offers.py",
          "{phase_dir}/browser-offers.json",
          "--schema",
          "schemas/m0-browser-offers-v1.schema.json",
          "--dependency-lock",
          "dependencies.lock.json"
        ]
      ],
      "environment_names": ["PLAYWRIGHT_BROWSERS_PATH"],
      "environment_values": { "PLAYWRIGHT_BROWSERS_PATH": "0" },
      "timeout_seconds": 600
    },
    {
      "id": "nvenc-browser-fixture",
      "title": "NVENC 720p30 fixture, independent decode, and two-browser recovery matrix",
      "kind": "command",
      "required": true,
      "dependencies": [
        "gpu-selection",
        "doctor-gpu",
        "nvenc-ownership-failure-contracts",
        "browser-offers"
      ],
      "commands": [
        [
          "build/linux-gpu/glyphrelay",
          "browser-fixture",
          "--manifest",
          "protocols/m0_fixed_map_v1/manifest.lock",
          "--output",
          "{phase_dir}/fixture"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_m0_browser_fixture.py",
          "{phase_dir}/fixture",
          "schemas/m0-browser-fixture-v1.schema.json"
        ],
        [
          "corepack",
          "pnpm",
          "run",
          "browser:matrix",
          "--",
          "--answerer",
          "build/linux-gpu/glyphrelay_m0_webrtc_sender",
          "--fixture",
          "{phase_dir}/fixture",
          "--output",
          "{phase_dir}/matrix"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_m0_browser_matrix.py",
          "{phase_dir}/matrix",
          "{phase_dir}/fixture",
          "--schemas",
          "schemas"
        ]
      ],
      "environment_names": ["PLAYWRIGHT_BROWSERS_PATH"],
      "environment_values": { "PLAYWRIGHT_BROWSERS_PATH": "0" },
      "timeout_seconds": 7200
    },
    {
      "id": "m0-fixed-map-quality",
      "title": "Frozen fixed-map quality, bitrate, latency, and cleanup experiment",
      "kind": "command",
      "required": true,
      "dependencies": [
        "gpu-selection",
        "doctor-gpu",
        "nvenc-ownership-failure-contracts"
      ],
      "commands": [
        [
          "build/linux-gpu/glyphrelay",
          "benchmark",
          "--manifest",
          "protocols/m0_fixed_map_v1/manifest.lock",
          "--output",
          "{phase_dir}/benchmark"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_m0_benchmark.py",
          "{phase_dir}/benchmark",
          "--schemas",
          "schemas",
          "--manifest",
          "protocols/m0_fixed_map_v1/manifest.lock"
        ]
      ],
      "environment_names": [],
      "timeout_seconds": 28800,
      "resource_policy": "nvenc-performance-v1"
    },
    {
      "id": "cuda-saliency-correctness",
      "title": "CUDA color conversion and saliency differential qualification",
      "kind": "command",
      "required": true,
      "dependencies": ["gpu-selection"],
      "commands": [
        [
          "build/linux-gpu/glyphrelay_cuda_saliency_qualify",
          "--correctness",
          "--output",
          "{phase_dir}/correctness.json"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_cuda_saliency_qualification.py",
          "{phase_dir}/correctness.json",
          "schemas/cuda-saliency-qualification-v1.schema.json"
        ]
      ],
      "environment_names": [],
      "timeout_seconds": 1800
    },
    {
      "id": "cuda-saliency-compute-sanitizer",
      "title": "CUDA saliency compute-sanitizer qualification",
      "kind": "command",
      "required": true,
      "dependencies": ["cuda-saliency-correctness"],
      "commands": [
        [
          "compute-sanitizer",
          "--tool",
          "memcheck",
          "--error-exitcode",
          "9",
          "build/linux-gpu/glyphrelay_cuda_saliency_qualify",
          "--correctness",
          "--output",
          "{phase_dir}/memcheck.json"
        ],
        [
          "compute-sanitizer",
          "--tool",
          "initcheck",
          "--error-exitcode",
          "9",
          "build/linux-gpu/glyphrelay_cuda_saliency_qualify",
          "--correctness",
          "--output",
          "{phase_dir}/initcheck.json"
        ],
        [
          "compute-sanitizer",
          "--tool",
          "racecheck",
          "--error-exitcode",
          "9",
          "build/linux-gpu/glyphrelay_cuda_saliency_qualify",
          "--correctness",
          "--output",
          "{phase_dir}/racecheck.json"
        ],
        [
          "compute-sanitizer",
          "--tool",
          "synccheck",
          "--error-exitcode",
          "9",
          "build/linux-gpu/glyphrelay_cuda_saliency_qualify",
          "--correctness",
          "--output",
          "{phase_dir}/synccheck.json"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_cuda_saliency_qualification.py",
          "{phase_dir}/memcheck.json",
          "schemas/cuda-saliency-qualification-v1.schema.json"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_cuda_saliency_qualification.py",
          "{phase_dir}/initcheck.json",
          "schemas/cuda-saliency-qualification-v1.schema.json"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_cuda_saliency_qualification.py",
          "{phase_dir}/racecheck.json",
          "schemas/cuda-saliency-qualification-v1.schema.json"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_cuda_saliency_qualification.py",
          "{phase_dir}/synccheck.json",
          "schemas/cuda-saliency-qualification-v1.schema.json"
        ]
      ],
      "environment_names": [],
      "timeout_seconds": 7200
    },
    {
      "id": "cuda-saliency-performance",
      "title": "CUDA 1080p30 preprocessing and map-copy P95 gate",
      "kind": "command",
      "required": true,
      "dependencies": [
        "cuda-saliency-correctness",
        "cuda-saliency-compute-sanitizer"
      ],
      "commands": [
        [
          "build/linux-gpu/glyphrelay_cuda_saliency_qualify",
          "--performance",
          "--output",
          "{phase_dir}/performance.json"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_cuda_saliency_qualification.py",
          "{phase_dir}/performance.json",
          "schemas/cuda-saliency-qualification-v1.schema.json"
        ]
      ],
      "environment_names": [],
      "timeout_seconds": 1800,
      "resource_policy": "cuda-performance-v1"
    },
    {
      "id": "saliency-development-selection",
      "title": "Complete frozen saliency development grid and repository freeze",
      "kind": "command",
      "required": true,
      "dependencies": [
        "language-dependencies",
        "cuda-saliency-correctness",
        "cuda-saliency-compute-sanitizer",
        "cuda-saliency-performance"
      ],
      "commands": [
        [
          "uv",
          "run",
          "python",
          "tools/run_saliency_development.py",
          "--native",
          "build/linux-gpu/glyphrelay_saliency_development",
          "--renderer-directory",
          "{phase_dir}/render",
          "--checkpoint-root",
          "{phase_root}/checkpoint",
          "--phase-output",
          "{phase_dir}",
          "--source-bundle-id",
          "{source_bundle_id}",
          "--processing-platform-sha256",
          "{environment_fingerprint}"
        ]
      ],
      "environment_names": [
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "UV_CACHE_DIR"
      ],
      "timeout_seconds": 86400,
      "resource_policy": "cuda-performance-v1"
    },
    {
      "id": "nvenc-enhanced-runtime",
      "title": "Enhanced NVENC multi-flight output and teardown qualification",
      "kind": "command",
      "required": true,
      "dependencies": [
        "language-dependencies",
        "gpu-selection",
        "nvenc-capability",
        "m0-fixed-map-quality",
        "cuda-saliency-correctness",
        "saliency-development-selection"
      ],
      "commands": [
        [
          "uv",
          "run",
          "python",
          "tools/run_nvenc_enhanced.py",
          "--native",
          "build/linux-gpu/glyphrelay_nvenc_encoder_qualify",
          "--selection",
          "protocols/saliency_v1/selected-configuration.json",
          "--output",
          "{phase_dir}/encoder"
        ],
        [
          "uv",
          "run",
          "python",
          "tools/validate_nvenc_enhanced.py",
          "{phase_dir}/encoder/evidence.json",
          "schemas/nvenc-enhanced-qualification-v1.schema.json",
          "protocols/saliency_v1/selected-configuration.json",
          "{phase_dir}/validation.json"
        ]
      ],
      "environment_names": ["UV_CACHE_DIR"],
      "timeout_seconds": 1800,
      "resource_policy": "nvenc-performance-v1"
    },
    {
      "id": "uniform-aq-development-selection",
      "title": "Complete frozen uniform AQ development grid and repository freeze",
      "kind": "command",
      "required": true,
      "dependencies": [
        "browser-install",
        "language-dependencies",
        "saliency-development-selection",
        "nvenc-enhanced-runtime"
      ],
      "commands": [
        [
          "uv",
          "run",
          "python",
          "tools/run_uniform_aq_development.py",
          "--native",
          "build/linux-gpu/glyphrelay_uniform_aq_evaluate",
          "--renderer-directory",
          "{phase_dir}/render",
          "--checkpoint-root",
          "{phase_root}/aq-checkpoint",
          "--phase-output",
          "{phase_dir}",
          "--source-bundle-id",
          "{source_bundle_id}",
          "--processing-platform-sha256",
          "{environment_fingerprint}"
        ]
      ],
      "environment_names": [
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "UV_CACHE_DIR"
      ],
      "timeout_seconds": 86400,
      "resource_policy": "nvenc-performance-v1"
    },
    {
      "id": "saliency-validation",
      "title": "Run the immutable one-shot saliency validation gate",
      "kind": "command",
      "required": true,
      "dependencies": [
        "saliency-development-selection",
        "uniform-aq-development-selection"
      ],
      "commands": [
        [
          "uv",
          "run",
          "python",
          "tools/run_saliency_validation.py",
          "--native",
          "build/linux-gpu/glyphrelay_saliency_validation",
          "--checkpoint-root",
          "{phase_root}/validation-checkpoint",
          "--phase-output",
          "{phase_dir}",
          "--source-bundle-id",
          "{source_bundle_id}",
          "--processing-platform-sha256",
          "{environment_fingerprint}"
        ]
      ],
      "environment_names": [
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "UV_CACHE_DIR"
      ],
      "timeout_seconds": 7200,
      "resource_policy": "cuda-performance-v1"
    }
  ]
}
