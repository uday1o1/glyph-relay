# Required only for a non-loopback remote-sharing deployment.
# GLYPHRELAY_SIGNALING_ORIGIN=https://share.example.invalid
# GLYPHRELAY_SIGNALING_CA_PATH=/run/secrets/signaling-ca.crt
# GLYPHRELAY_BIND_HOST=0.0.0.0
# GLYPHRELAY_PORT=8443
# GLYPHRELAY_TLS_CERT_PATH=/run/secrets/tls.crt
# GLYPHRELAY_TLS_KEY_PATH=/run/secrets/tls.key
# GLYPHRELAY_HEALTHCHECK_CA_PATH=/run/secrets/healthcheck-ca.crt
# GLYPHRELAY_MAX_SESSIONS=64
# GLYPHRELAY_MAX_CONNECTIONS=128
# GLYPHRELAY_TURN_URL=turn:turn.example.invalid:3478?transport=udp
