{
  "name": "glyphrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first text-aware screen sharing and recording",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "browser:harness": "node tooling/m0/verify-loopback-receiver.ts",
    "browser:matrix": "node tooling/m0/qualify-browser-matrix.ts",
    "browser:playback": "node tooling/m0/qualify-browser-playback.ts",
    "browser:oracle:freeze": "node tooling/m0/freeze-browser-oracle.ts",
    "browser:probe": "node tooling/m0/capture-browser-offers.ts --output build/m0-browser-offers.json",
    "signaling:start": "node signaling/main.ts",
    "signaling:verify": "node tooling/signaling/verify-bundle.ts",
    "test": "node --test tests/typescript/*.test.ts tests/typescript/*.test.js",
    "typecheck": "tsc --noEmit && node --check receiver/receiver.js && node --check receiver/control-protocol.js && node --check receiver/v1-receiver.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/ws": "8.18.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}
