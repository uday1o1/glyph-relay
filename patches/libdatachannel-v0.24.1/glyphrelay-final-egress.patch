+
+void RtpPacketizationConfig::setExtendedSequenceNumber(uint64_t value) {
+	extendedSequenceNumber = value;
+	sequenceNumber = static_cast<uint16_t>(value & 0xFFFF);
+}
+
+void RtpPacketizationConfig::setExtendedTimestamp(uint64_t value) {
+	extendedTimestamp = value;
+	timestamp = static_cast<uint32_t>(value & 0xFFFFFFFF);
+}
+
+void RtpPacketizationConfig::setTimestamp(uint32_t value) {
+	constexpr uint64_t WireTimestampModulus = uint64_t(1) << 32;
+	auto candidate = (extendedTimestamp & ~(WireTimestampModulus - 1)) | value;
+	if (candidate < extendedTimestamp)
+		candidate += WireTimestampModulus;
+	setExtendedTimestamp(candidate);
 }
 
