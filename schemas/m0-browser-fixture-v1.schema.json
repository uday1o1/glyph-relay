{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphrelay.invalid/schemas/m0-browser-fixture-v1.schema.json",
  "title": "GlyphRelay Milestone 0 NVENC browser fixture evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "status",
    "manifest_sha256",
    "presentation",
    "width",
    "height",
    "frames_per_second",
    "level_idc",
    "warmup_frames",
    "measurement_frames",
    "frame_count",
    "requested_bps",
    "measurement_bytes",
    "payload_bps",
    "configuration_sha256",
