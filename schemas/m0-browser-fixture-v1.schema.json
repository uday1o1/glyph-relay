    "warmup_frames": { "const": 300 },
    "measurement_frames": { "const": 1800 },
    "frame_count": { "const": 2100 },
    "requested_bps": { "const": 2000000 },
    "measurement_bytes": { "type": "integer", "minimum": 1 },
    "payload_bps": { "type": "number", "exclusiveMinimum": 0 },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "stream_sha256": { "$ref": "#/$defs/sha256" },
    "frame_table_sha256": { "$ref": "#/$defs/sha256" },
    "configuration_file_sha256": { "$ref": "#/$defs/sha256" },
    "source_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_0", "frame_300", "frame_2099"],
      "properties": {
        "frame_0": {
          "const": "858b32ab999e6193daf9035ec26b9d3e0893d1faa3bc3404a7721fcc4b09c6e6"
        },
        "frame_300": {
          "const": "35ea1743773a43b1f785121e864bcf66c8c510591d1d17e015fd9be597a6d3f3"
        },
        "frame_2099": {
          "const": "52443d6562be5e66cfc716a5f8c05df96f18e79a4663f0f4dbb0845542594abd"
