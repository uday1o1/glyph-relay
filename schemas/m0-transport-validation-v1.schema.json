{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphrelay.invalid/schemas/m0-transport-validation-v1.schema.json",
  "title": "GlyphRelay final UDP hook packet-capture validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "status",
    "coturnImage",
    "supportedIpv6",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocol": { "const": "glyphrelay-m0-transport-validation-v1" },
    "status": { "const": "PASSED" },
    "coturnImage": {
      "type": "string",
      "pattern": "^coturn/coturn:[0-9.]+-r[0-9]+@sha256:[0-9a-f]{64}$"
    },
    "supportedIpv6": { "type": "boolean" },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "support",
        "hookDatagrams",
        "packetCaptureDatagrams",
        "hookIpTotalBytes",
        "packetCaptureIpTotalBytes",
        "mediaDatagrams",
        "controlDatagrams",
        "protocols"
      ],
      "properties": {
        "scenario": { "enum": ["direct-ipv4", "direct-ipv6", "turn-udp"] },
        "support": { "enum": ["SUPPORTED", "UNSUPPORTED"] },
        "hookDatagrams": { "type": "integer", "minimum": 0 },
        "packetCaptureDatagrams": { "type": "integer", "minimum": 0 },
        "hookIpTotalBytes": { "type": "integer", "minimum": 0 },
        "packetCaptureIpTotalBytes": { "type": "integer", "minimum": 0 },
        "mediaDatagrams": { "type": "integer", "minimum": 0 },
        "controlDatagrams": { "type": "integer", "minimum": 0 },
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
        }
      }
    }
  }
}
