{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphrelay.invalid/schemas/m0-benchmark-summary-v1.schema.json",
  "title": "GlyphRelay Milestone 0 encoder summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "manifest_sha256", "conditions"],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol": { "const": "m0_fixed_map_v1" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "selected_requested_bps", "calibration", "runs"],
        "properties": {
          "name": { "enum": ["controlled_uniform", "fixed_emphasis_level_4"] },
          "selected_requested_bps": {
            "type": "integer",
            "minimum": 800000,
            "maximum": 1200000
          },
          "calibration": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": { "$ref": "#/$defs/point" }
          },
          "runs": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": { "$ref": "#/$defs/run" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_bps", "measured_bps", "configuration_sha256"],
      "properties": {
        "requested_bps": {
          "type": "integer",
          "minimum": 800000,
          "maximum": 1200000
        },
        "measured_bps": { "type": "number", "minimum": 0 },
        "configuration_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat",
        "measurement_bytes",
        "payload_bps",
        "configuration_sha256",
        "whole_frame_psnr_db",
        "protected_psnr_db",
        "comparison_psnr_db",
        "protected_minus_comparison_db"
      ],
      "properties": {
        "repeat": { "type": "integer", "minimum": 1, "maximum": 10 },
        "measurement_bytes": { "type": "integer", "minimum": 1 },
        "payload_bps": { "type": "number", "minimum": 0 },
        "configuration_sha256": { "$ref": "#/$defs/sha256" },
        "whole_frame_psnr_db": { "type": "number" },
        "protected_psnr_db": { "type": "number" },
        "comparison_psnr_db": { "type": "number" },
        "protected_minus_comparison_db": { "type": "number" }
      }
    }
  }
}
