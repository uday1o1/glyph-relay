{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphrelay.invalid/schemas/qualification-status-v1.schema.json",
  "title": "GlyphRelay qualification status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "bundle_id",
    "status",
    "updated_at_utc",
    "selected_gpu_uuid",
    "phases",
    "reclaimed_locks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "bundle_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["RUNNING", "PASSED", "FAILED", "BLOCKED"] },
    "updated_at_utc": { "type": "string", "format": "date-time" },
    "selected_gpu_uuid": { "type": ["string", "null"] },
    "phases": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "additionalProperties": {
        "enum": ["PASSED", "FAILED", "BLOCKED", "DEFERRED_INTERACTIVE"]
      }
    },
    "reclaimed_locks": { "type": "array", "items": { "type": "object" } },
    "reason": { "type": "string", "minLength": 1 }
  }
}
